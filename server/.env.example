# Copy this file to .env and fill in once you register a Socrata app token.
# Without a token, requests are still allowed but heavily rate-limited (throttled per IP).
SOCRATA_APP_TOKEN=

PORT=3001

# Postgres — matches docker-compose.yml at the repo root (`docker compose up -d`).
DATABASE_URL=postgres://plate_lookup:plate_lookup@localhost:5432/plate_lookup

# Signing secret for auth JWTs. Generate one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
